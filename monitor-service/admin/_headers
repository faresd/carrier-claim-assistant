/*
  Cache-Control: no-store
  Content-Security-Policy: default-src 'self'; base-uri 'none'; connect-src 'self' https://auth.cheaply.fr; form-action 'self'; frame-ancestors 'none'; img-src 'self' https://auth.cheaply.fr data:; object-src 'none'; script-src 'self' https://auth.cheaply.fr; style-src 'self' https://auth.cheaply.fr
  Permissions-Policy: camera=(), geolocation=(), microphone=(), payment=(), usb=()
  Referrer-Policy: no-referrer
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
