{
  "client_id": "tracking-web",
  "application_origin": "https://tracking.cheaply.fr",
  "redirect_uris": [
    "https://tracking.cheaply.fr/api/auth/callback"
  ],
  "grant_types": [
    "authorization_code"
  ],
  "response_types": [
    "code"
